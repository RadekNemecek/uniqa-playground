rules_version = '2';

// Pravidla pro Mučírnu.
//
// Otázky, obrázky, sady Výslechu i výsledky patří prostoru (`spaces`) a čte
// a mění je jen jeho člen. Členem je ověřený e-mail zapsaný v `members`,
// přihlašuje se odkazem z pošty. Admin navíc spravuje členy, editor smí
// všechno ostatní.
//
// Hráč s telefonem se nepřihlašuje, je anonymní. Do prostoru nevidí,
// zná jen kód běžící hry a session je postavená tak, aby mu nic neprozradila.

service cloud.firestore {
  match /databases/{database}/documents {

    /* --- Kdo je kdo --------------------------------------------------- */

    // Přihlášený e-mailem. Anonymní telefon hráče e-mail nemá a odkaz
    // z pošty zároveň e-mail ověřuje, takže tohle cizí adresu nepustí.
    function signedIn() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function me() {
      return request.auth.token.email.lower();
    }

    function memberPath(space) {
      return /databases/$(database)/documents/spaces/$(space)/members/$(me());
    }

    // Nepřijatá pozvánka platí tři dny od posledního odeslání. Pak už
    // nikoho nepustí dovnitř, admin ji musí poslat znovu (to posune
    // `invitedAt`). Kdo pozvánku jednou přijal, má `joinedAt` a lhůta
    // se ho netýká. Stejnou lhůtu zná aplikace (`INVITE_DAYS`).
    function inviteHolds(m) {
      return 'joinedAt' in m
        || request.time < m.get('invitedAt', m.addedAt) + duration.value(3, 'd');
    }

    function isMember(space) {
      return signedIn()
        && exists(memberPath(space))
        && inviteHolds(get(memberPath(space)).data);
    }

    function isAdmin(space) {
      return isMember(space) && get(memberPath(space)).data.role == 'admin';
    }

    /* --- Prostor a jeho data ------------------------------------------ */

    match /spaces/{space} {
      allow get: if isMember(space);
      allow list: if false;
      // Prostor zakládá a ruší skript. Admin smí jen přejmenovat.
      allow create, delete: if false;
      allow update: if isAdmin(space)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 80;

      // Členové. Id je e-mail malými písmeny, protože správkyně přidává
      // kolegyni dřív, než se ta poprvé přihlásí a dostane uid. Stejný
      // e-mail nese i pole `email`, podle něj se hledá, kam kdo patří.
      //
      // Sám sebe nikdo neodebere ani nesesadí. Dokud jsou admini dva,
      // nejde se omylem zamknout venku.
      match /members/{email} {
        allow read: if isMember(space);

        allow create: if isAdmin(space)
                      && email != me()
                      && email == email.lower()
                      && request.resource.data.keys().hasOnly(['email', 'role', 'name', 'addedBy', 'addedAt'])
                      && request.resource.data.email == email
                      && request.resource.data.role in ['admin', 'editor']
                      && validName(request.resource.data)
                      && request.resource.data.addedBy == me()
                      && request.resource.data.addedAt == request.time;

        // Admin mění roli a jméno a znovu posílá pozvánku. Člen si sám
        // mění jen svoje jméno a jednou zapíše, že pozvánku přijal:
        // podle toho správa pozná, komu pozvánka propadla.
        allow update: if (isAdmin(space)
                          && email != me()
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['role', 'name', 'invitedAt'])
                          && request.resource.data.role in ['admin', 'editor']
                          && validName(request.resource.data)
                          && (!('invitedAt' in request.resource.data)
                              || request.resource.data.invitedAt == resource.data.get('invitedAt', null)
                              || request.resource.data.invitedAt == request.time))
                      || (isMember(space)
                          && email == me()
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedAt', 'name'])
                          && validName(request.resource.data)
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['joinedAt'])
                              || (!('joinedAt' in resource.data)
                                  && request.resource.data.joinedAt == request.time)));

        allow delete: if isAdmin(space) && email != me();
      }

      // Balíčky desky Pojišťuj! a kvízu, sady Výslechu.
      match /packs/{id} {
        allow read, write: if isMember(space);
      }
      match /quizPacks/{id} {
        allow read, write: if isMember(space);
      }
      match /vyslechForms/{id} {
        allow read, write: if isMember(space);
      }

      // Obrázky k otázkám kvízu, jeden dokument na obrázek. Strop hlídá
      // i pravidlo: dokument Firestore unese 1 MiB a obrázek, který by se
      // přes rozhraní nedostal, sem nemá projít ani jinudy.
      match /quizImages/{imageId} {
        allow read: if isMember(space);
        allow write: if isMember(space)
                     && (request.method == 'delete'
                         || (request.resource.data.id == imageId
                             && request.resource.data.data.size() < 900000));
      }

      // Vyhodnocení kvízu. Jsou v něm přezdívky účastníků. Zapsané se už
      // nemění, aby se výsledky nedaly přepsat zpětně. `hostEmail` říká,
      // kdo školení vedl.
      match /quizReports/{reportId} {
        allow read: if isMember(space);
        allow create: if isMember(space)
                      && request.resource.data.hostUid == request.auth.uid
                      && request.resource.data.hostEmail == me()
                      && request.resource.data.schema == 1
                      && request.resource.data.keys().hasAll(['id', 'groupName', 'round',
                           'packNames', 'startedAt', 'finishedAt', 'questions', 'players', 'matrix'])
                      && request.resource.data.groupName is string
                      && request.resource.data.groupName.size() <= 120
                      && (!('trainer' in request.resource.data)
                          || (request.resource.data.trainer is string
                              && request.resource.data.trainer.size() <= 80))
                      && request.resource.data.questions is list
                      && request.resource.data.questions.size() <= 200
                      && request.resource.data.players is list
                      && request.resource.data.players.size() <= 300
                      && request.resource.data.matrix is list
                      && request.resource.data.matrix.size() <= 200;
        allow update: if false;
        allow delete: if isMember(space);
      }

      // Odehrané hry desky Pojišťuj!: skóre týmů a úspěšnost kategorií,
      // bez jmen účastníků. Na rozdíl od vyhodnocení kvízu se přepsat
      // smí: moderátorka se z výsledků může vrátit na desku a dohrát,
      // a pak se tentýž záznam zapíše znovu. Jen ten, kdo hru vedl.
      match /pojistujRuns/{runId} {
        allow read, delete: if isMember(space);
        allow create, update: if isMember(space)
                      && request.resource.data.hostEmail == me()
                      && (request.method == 'create' || resource.data.hostEmail == me())
                      && request.resource.data.schema == 1
                      && request.resource.data.id == runId
                      && request.resource.data.keys().hasAll(['id', 'groupName', 'packName',
                           'startedAt', 'finishedAt', 'teams', 'categories'])
                      && request.resource.data.groupName is string
                      && request.resource.data.groupName.size() <= 120
                      && request.resource.data.packName is string
                      && request.resource.data.packName.size() <= 120
                      && (!('trainer' in request.resource.data)
                          || (request.resource.data.trainer is string
                              && request.resource.data.trainer.size() <= 80))
                      && request.resource.data.teams is list
                      && request.resource.data.teams.size() <= 6
                      && request.resource.data.categories is list
                      && request.resource.data.categories.size() <= 6;
      }

      // Vyhodnocení Výslechu. Bez identit, ale s volnými odpověďmi, ve
      // kterých se jména objevit můžou. Kdo sběr spustil, se schválně
      // neukládá: obvykle je to lektor, kterého se hodnocení týká.
      match /vyslechReports/{reportId} {
        allow read: if isMember(space);
        allow create: if isMember(space)
                      && request.resource.data.hostUid == request.auth.uid
                      && request.resource.data.schema == 1
                      && request.resource.data.keys().hasAll(['id', 'title', 'formId',
                           'questions', 'responses', 'startedAt', 'finishedAt'])
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 120
                      && request.resource.data.questions is list
                      && request.resource.data.questions.size() <= 20
                      && request.resource.data.responses is list
                      && request.resource.data.responses.size() <= 1000;
        allow update: if false;
        allow delete: if isMember(space);
      }
    }

    function validName(data) {
      return !('name' in data)
        || (data.name is string && data.name.size() <= 80);
    }

    // Kam patřím. Aplikace po přihlášení hledá svoje členství přes všechny
    // prostory dotazem na pole `email`, a ten se dá ověřit jen proti poli,
    // ne proti id dokumentu.
    match /{path=**}/members/{email} {
      allow read: if signedIn() && resource.data.email == me();
    }

    /* --- Živá hra kvízu -------------------------------------------------- */

    // Session se při každém zápisu hráče čte pravidlem. Firestore si
    // výsledek `get()` v rámci jednoho požadavku pamatuje, takže opakované
    // volání stojí jedno čtení, ne pět.
    function session(code) {
      return get(/databases/$(database)/documents/quiz/$(code)).data;
    }

    function isPlaying(code) {
      return request.auth != null
        && exists(/databases/$(database)/documents/quiz/$(code)/players/$(request.auth.uid));
    }

    // Běžící hra. Čte ji každý, kdo zná kód, ale není v ní jediné písmeno
    // otázky ani stopa po správné možnosti. Kdo kód uhodne, dozví se
    // nanejvýš, že někde běží sedmá otázka. Seznam běžících her nedostane
    // nikdo, jinak by šlo projít kódy hromadně.
    match /quiz/{code} {
      allow get: if true;
      allow list: if false;

      // Hru otevírá člen prostoru, ze kterého jsou otázky. Vlastnictví
      // i prostor se zapisují hned a už se nemění.
      allow create: if isMember(request.resource.data.spaceId)
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.code == code
                    && request.resource.data.phase == 'lobby'
                    && request.resource.data.schema == 1
                    && request.resource.data.round is int
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.time;

      // Měnit smí jen vlastník a nesmí si přepsat vlastnictví, prostor
      // ani kód. Poslední podmínka je pojistka proti chybě v kódu hry:
      // dokud otázka běží, nesmí se do session dostat nic o odhalení.
      // Chyba tak skončí odmítnutým zápisem, ne vyzrazenou odpovědí.
      allow update: if request.auth != null
                    && resource.data.hostUid == request.auth.uid
                    && request.resource.data.hostUid == resource.data.hostUid
                    && request.resource.data.spaceId == resource.data.spaceId
                    && request.resource.data.code == resource.data.code
                    && (request.resource.data.phase != 'question'
                        || !('reveal' in request.resource.data));

      // Uklidit smí vlastník, a po vypršení kdokoli: jinak by zabraný kód
      // držela mrtvá hra navěky a nikdo by ho nedostal zpátky.
      allow delete: if (request.auth != null && resource.data.hostUid == request.auth.uid)
                    || resource.data.expiresAt < request.time;
    }

    // Soupiska. Body v ní schválně nejsou, ty počítá moderátorka a posílá
    // je v session, takže hráči tu není co měnit.
    match /quiz/{code}/players/{uid} {
      allow get: if request.auth != null
                 && (request.auth.uid == uid || session(code).hostUid == request.auth.uid);
      allow list: if request.auth != null && session(code).hostUid == request.auth.uid;

      // Identita hráče je jeho anonymní uid. Po obnovení stránky pokračuje
      // tentýž hráč a druhou kartu si založit nemůže.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && session(code).acceptsPlayers == true
                    && session(code).expiresAt > request.time
                    && request.resource.data.keys()
                         .hasOnly(['nick', 'avatar', 'joinedAt', 'joinedAtIndex', 'expiresAt'])
                    && request.resource.data.nick is string
                    && request.resource.data.nick.size() >= 1
                    && request.resource.data.nick.size() <= 20
                    // Zvíře je jen identifikátor z aplikace. Kdo pole
                    // nepošle vůbec, je telefon s uloženou starší verzí
                    // a hrát mu to bránit nemá.
                    && (!('avatar' in request.resource.data)
                        || (request.resource.data.avatar is string
                            && request.resource.data.avatar.size() <= 16))
                    && request.resource.data.joinedAt == request.time
                    && request.resource.data.joinedAtIndex == session(code).index
                    && request.resource.data.expiresAt == session(code).expiresAt;

      // Přejmenovat nebo vyhodit hráče smí jen moderátorka.
      allow update, delete: if request.auth != null
                            && session(code).hostUid == request.auth.uid;
    }

    // Odpověď. Jeden dokument na hráče a otázku, id složené z kola, otázky
    // a hráče. Druhá odpověď na tutéž otázku by byla update, a ten tu nemá
    // povolený nikdo.
    match /quiz/{code}/answers/{answerId} {
      // Cizí odpověď si hráč nepřečte. Ani svoji nepotřebuje, co zmáčkl
      // ví jeho telefon sám.
      allow get, list: if request.auth != null && session(code).hostUid == request.auth.uid;

      allow create: if isPlaying(code)
        && answerId == string(session(code).round) + '_'
                     + request.resource.data.qid + '_' + request.auth.uid
        && request.resource.data.keys()
             .hasOnly(['uid', 'round', 'qid', 'choice', 'elapsedMs', 'at', 'expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.round == session(code).round
        && request.resource.data.qid == session(code).qid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= session(code).expiresAt
        && request.resource.data.choice is int
        && request.resource.data.choice >= 0
        && request.resource.data.choice <= 3
        && request.resource.data.elapsedMs is int
        && request.resource.data.elapsedMs >= 0
        && request.resource.data.elapsedMs <= session(code).limitMs
        // Čas odpovědi razítkuje server, ne telefon.
        && request.resource.data.at == request.time
        // Otázka musí běžet. Dopředu se odpovídat nedá.
        && session(code).phase == 'question'
        && request.time > session(code).askedAt
        // A nesmí být po termínu. Hlídá to server, ne moderátorčin
        // prohlížeč: kdyby jí uprostřed otázky vypadla síť a fázi
        // nepřepnula, pozdní odpověď stejně neprojde.
        // `elapsedMs` se proti času serveru neporovnává. Telefon se může
        // o začátku otázky dozvědět se zpožděním a taková kontrola by pak
        // odmítla poctivou odpověď. Konec limitu dál určuje server.
        && request.time < session(code).askedAt + duration.value(
             session(code).preRollMs + session(code).limitMs + 2000, 'ms');

      // Opravit nebo smazat odpověď smí jen moderátorka.
      allow update, delete: if request.auth != null
                            && session(code).hostUid == request.auth.uid;
    }

    /* --- Výslech, sběr zpětné vazby ------------------------------------ */

    function vyslech(code) {
      return get(/databases/$(database)/documents/vyslech/$(code)).data;
    }

    // Běžící sběr. Otázky v něm jsou veřejně schválně: telefon je musí
    // zobrazit. Odpovědi v něm nejsou. Seznam běžících sběrů nedostane
    // nikdo, jinak by šlo kódy projít hromadně.
    match /vyslech/{code} {
      allow get: if true;
      allow list: if false;

      // Otevřít sběr smí jen člen prostoru, ze kterého je sada.
      allow create: if isMember(request.resource.data.spaceId)
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.code == code
                    && request.resource.data.phase == 'open'
                    && request.resource.data.schema == 1
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.questions is list
                    && request.resource.data.questions.size() <= 20
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.time;

      // Měnit smí jen vlastník a nesmí si přepsat vlastnictví, prostor,
      // kód ani dobu platnosti, podle které se ověřují odpovědi.
      allow update: if request.auth != null
                    && resource.data.hostUid == request.auth.uid
                    && request.resource.data.hostUid == resource.data.hostUid
                    && request.resource.data.spaceId == resource.data.spaceId
                    && request.resource.data.code == resource.data.code
                    && request.resource.data.expiresAt == resource.data.expiresAt;

      // Uklidit smí vlastník, a po vypršení kdokoli.
      allow delete: if (request.auth != null && resource.data.hostUid == request.auth.uid)
                    || resource.data.expiresAt < request.time;
    }

    // Odeslaný dotazník. Jeden dokument na telefon, id je anonymní uid.
    // Druhé odeslání téhož telefonu je update a přepíše první, takže se
    // jeden člověk nezapočítá dvakrát.
    match /vyslech/{code}/responses/{uid} {
      allow get: if request.auth != null
                 && (request.auth.uid == uid || vyslech(code).hostUid == request.auth.uid);
      allow list: if request.auth != null && vyslech(code).hostUid == request.auth.uid;

      // Jen vlastní dokument a jen dokud sběr běží. Po ukončení neprojde
      // nic, ani když telefon ukončení ještě nezaznamenal.
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && vyslech(code).phase == 'open'
                            && vyslech(code).expiresAt > request.time
                            && request.resource.data.keys().hasOnly(['answers', 'at', 'expiresAt'])
                            && request.resource.data.answers is map
                            && request.resource.data.answers.size() <= 20
                            && request.resource.data.at == request.time
                            && request.resource.data.expiresAt == vyslech(code).expiresAt;

      allow delete: if request.auth != null && vyslech(code).hostUid == request.auth.uid;
    }

    // Všechno ostatní je zavřené, i původní kolekce z doby hesla do správy
    // (`config`, `unlocks` a balíčky mimo prostor).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
