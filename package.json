{
  "name": "uniqa-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playground: interaktivní školicí hry. První hra: Riskuj.",
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_LOCAL_ONLY=1 vite --port 5185 --strictPort",
    "build": "vue-tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "build:only": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "sharp": "^0.35.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^2.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
